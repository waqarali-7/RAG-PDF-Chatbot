# Copy this file to .env.local and add your keys.

# Always required (used for embeddings regardless of provider).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# LLM provider for chat completions: "openai" (default) or "anthropic".
# LLM_PROVIDER=openai

# Required when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5
